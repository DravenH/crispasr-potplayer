; ===== CrispASR PotPlayer 垫片配置 =====
; 复制为 shim.ini 放在 whisper-faster.exe 同目录；某项留空 = 自动探测。
; 组件按安装器布局摆放（同目录 CrispASR\ 与 CrispASR\models\）时可以不放本文件。

; crispasr.exe 完整路径；下载 https://github.com/CrispStrobe/CrispASR/releases
;（GPU 机建议 CUDA 版，RTX 50 系等新卡需 cuda13 构建）
crispasr=C:\tools\CrispASR\crispasr.exe
; 语音模型 GGUF；日语模型见 https://hf-mirror.com/cstr/parakeet-tdt-0.6b-ja-GGUF（f16 / q8_0 皆可）
model=C:\tools\CrispASR\models\parakeet-tdt-0.6b-ja.gguf
; 识别语言（parakeet-tdt-0.6b-ja 仅支持日语，保持 ja）
language=ja
; 追加给 crispasr 的参数：--split-on-punct 按标点断句，--flush-after 1 让字幕边跑边写出
extra=--split-on-punct --flush-after 1
; 1 = 强制 CPU 运行（默认 0，用 GPU）
nogpu=0
; 1 = 转录前先用 mel-band-roformer 分离人声（抗 BGM/OP，代价是慢约 3 倍、多占临时盘）。
; 需要分离模型与 ffmpeg（把音频重采样成分离要求的 44.1 kHz 立体声）；缺任一项则自动跳过分离、
; 直接转录原始音频且不报错。安装器勾选"启用人声分离"会把本项写成 1 并连带下载 ffmpeg。
vocals=0
; 分离模型 GGUF 路径；留空则自动探测同目录 CrispASR\models\mel-band-roformer-vocals-f16.gguf
;（下载 https://hf-mirror.com/cstr/mel-band-roformer-vocals-GGUF，≈436 MB，仅 f16）
separation_model=
; 1 = 在 %TEMP%\crispasr-xxl-shim.log 追加运行日志（排错用）
log=1
; 可选：ffmpeg 所在目录。垫片会把它注入 crispasr 子进程 PATH，供解码非常规音频时兜底；留空则跳过
ffmpeg_dir=
